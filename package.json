{
  "name": "linksketch",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test",
    "gate": "npm run typecheck && npm test && npm run build && npm run e2e",
    "shots": "npm run build && node scripts/shots.mjs",
    "sample": "vite-node scripts/make-sample.ts"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "marked": "^18.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
